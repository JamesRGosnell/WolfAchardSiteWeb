---
/**
 * PAGE-LOCAL. Heading + optional subheading + prose + photograph, on the live
 * 5/7 grid.
 *
 * Used twice, and the two sit on OPPOSITE sides because that is how the live
 * page lays them out:
 *
 *   `Suivez l'actualité financière` / `Keep up with financial news`
 *       photo in the 5-column LEFT, text in the 7-column right
 *   `À propos de la Banque Nationale` / `About National Bank of Canada`
 *       text in the 7-column LEFT, photo in the 5-column right
 *
 * `mediaSide` carries that from the data rather than from a page-level guess.
 *
 * THE SUBHEADING IS AN <h3> because the capture uses `<h3 class="cmp-title__
 * text">` for `L'une des institutions financières…` / `One of Canada's leading
 * financial institutions`, directly under the block's <h2>. Promoting it would
 * change the document outline away from live for a visual reason.
 *
 * The photograph is ALWAYS after the text in DOM order regardless of which
 * visual side it takes, so a screen reader and a narrow viewport both get
 * heading → prose → image. Only the grid order changes.
 */
import Figure from '../../components/Figure.astro';
import Prose from '../../components/Prose.astro';
import type { FirmSplit } from '../../data/pages/firm.types';
import type { Locale } from '../../data/types';

interface Props {
  block: FirmSplit;
  locale: Locale;
  headingId: string;
}

const { block, locale, headingId } = Astro.props;
---

<div class:list={['split', block.mediaSide === 'start' && 'split--media-start']}>
  <div class="split__text">
    <h2 id={headingId} class="t-h2 serif-display split__heading">{block.heading}</h2>
    {block.subheading && <h3 class="t-h3 split__subheading">{block.subheading}</h3>}
    {block.body.map((paragraph) => <Prose text={paragraph} locale={locale} class="split__prose" />)}
  </div>

  {
    block.image && (
      <div class="media split__media reveal">
        <Figure image={block.image} />
      </div>
    )
  }
</div>

<style>
  .split {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 60rem) {
    .split {
      /* The live grid: 7 columns of text against 5 of photograph. */
      grid-template-columns: 7fr 5fr;
      align-items: center;
      column-gap: clamp(2.5rem, 5vw, 4.5rem);
    }

    /* Photograph on the left, as the publications block has it live. DOM order
       is unchanged — only the visual columns swap. */
    .split--media-start .split__text {
      order: 2;
    }
  }

  .split__heading {
    margin: 0;
    max-inline-size: 22ch;
  }

  .split__subheading {
    margin: clamp(1rem, 2vw, 1.5rem) 0 0;
    max-inline-size: 30ch;
    color: var(--fg);
  }

  /* `<Prose>` and `<Figure>` forward the calling component's scope attribute
     (they spread `...rest` onto their root element), so a plain scoped rule
     DOES reach the paragraph they render. This was written as an anchored
     `:global()` descendant before that was true; it is kept because it is
     equally correct and strictly narrower — but a new rule does not need it.
     What is NOT safe is a bare `:global(.foo)` with no scoped ancestor: that
     leaks out of the component. */
  .split__text :global(.split__prose) {
    margin: clamp(1.25rem, 2.5vw, 1.75rem) 0 0;
    /* --measure, not a hand-picked `ch` count. See the token in global.css. */
    max-inline-size: var(--measure);
    line-height: 1.65;
  }

  /* 474×464 masters — very nearly square, and never asked to be anything else. */
  .split__media {
    aspect-ratio: 474 / 464;
  }

  @media (max-width: 59.99rem) {
    .split__media {
      aspect-ratio: 3 / 2;
    }
  }
</style>
