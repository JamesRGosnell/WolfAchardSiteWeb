---
/**
 * ENGLISH HOME — `/en/`
 *
 * ⚠ REWRITTEN 2026-08-03 AFTER THE CLIENT AMENDED P-16
 * (`content/COMPLIANCE.md` §6.5).
 *
 * This page used to omit `Our mission`, `Our commitments`, `Our philosophy` and
 * `What sets us apart` because the live English page has none of them and P-16
 * forbade writing them. **The client has authorised closing that gap by
 * translation of the published French copy**, so all four now render, from
 * `home.en.ts`, in the FRENCH page's own document order relative to one another
 * (lists · essay · distinctions), inserted after this page's two English-only
 * sections and before the process block. NC-20 … NC-23.
 *
 * WHAT DID NOT CHANGE, AND WHY THE GUARDS STAY:
 *
 *  · `home.intro` is STILL `undefined` in English — the French
 *    `Une gestion de patrimoine sur mesure…` block is on §6.5's exclusion list.
 *    Every section below is still guarded on its own data, so an absent section
 *    is absent rather than empty. Removing a guard would be trading a real
 *    structural fact for a heading over nothing.
 *  · The four process items are still bare labels, and they are still not the
 *    French four (qualities against steps — D-73), so the compact rail stays.
 *
 * BAND RHYTHM — the one thing this rewrite MOVED. DESIGN_BRIEF §4 allows
 * exactly one tint block per page. The tint used to sit on the process rail,
 * on the stated ground that "the thinnest section is also its most designed
 * one". That ground is gone: the page now carries eight sections, not five.
 * The tint moves to `Our philosophy`, which is where the French page has it —
 * so the two home pages now pause in the same place. One word per section, and
 * still exactly one tint block. D-71.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import HomeHero from '../_home/HomeHero.astro';
import Prose from '../../components/Prose.astro';
import Figure from '../../components/Figure.astro';
import RuledList from '../_home/RuledList.astro';
import ProcessBlock from '../_home/ProcessBlock.astro';
import NewsBlock from '../_home/NewsBlock.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import Button from '../../components/Button.astro';
import { t, pathFor } from '../../lib/i18n';
import home from '../../data/pages/home.en';

const locale = 'en' as const;
const s = t(locale);

/**
 * D-52 — the two onward links under the process block, the English twin of the
 * pair on `/`. This page did link `/en/team/`, but only as a single word inside
 * a sentence of body copy (live markup, `home.en.ts`), and it linked
 * `/en/services/` not at all.
 *
 * NO NEW COPY: the labels are `nav.items[].liveLabel`, the client's own live
 * navigation wording. Both trees get the same structure — that is the same rule
 * NC-01/NC-02 follow.
 */
const onward = (['services', 'team'] as const).map((key) => ({
  key,
  label: s.nav.items.find((item) => item.key === key)!.liveLabel,
  href: pathFor(key, locale),
}));
---

{/*
   D-11 — this page closes with its own <ContactBlock>: same heading, same
   lead sentence, same two direct lines as the footer's CTA band.
*/}
<BaseLayout
  locale={locale}
  pageKey="home"
  title={home.meta.title}
  description={home.meta.description}
  showFooterCta={false}
>
  <HomeHero hero={home.hero} locale={locale} />

  {
    home.support && (
      <Section bg="paper" aria-labelledby="support-heading">
        <div class="support">
          <h2 id="support-heading" class="t-h2 serif-display support__heading">
            {home.support.heading}
          </h2>
          <div class="support__body">
            {home.support.body.map((paragraph) => (
              <Prose text={paragraph} locale={locale} class="support__prose" />
            ))}
          </div>
        </div>
      </Section>
    )
  }

  {
    home.company && (
      <Section bg="paper" aria-labelledby="company-heading">
        <h2 id="company-heading" class="t-h2 serif-display company__heading">
          {home.company.heading}
        </h2>
        <div class="company">
          {home.company.image && (
            <div class="media company__media reveal">
              <Figure image={home.company.image} />
            </div>
          )}
          <div class="company__text">
            <h3 class="company__subheading">{home.company.subheading}</h3>
            <dl class="company__points">
              {home.company.points.map((point) => (
                <div class="company__point">
                  <dt class="company__point-title">{point.heading}</dt>
                  <dd class="company__point-body">
                    <Prose text={point.body} locale={locale} />
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </Section>
    )
  }

  {/* Mission + commitments. NC-20 / NC-21. No accessible name on the band, for
      the same reason as the French page: it holds TWO sibling <h3> lists, so
      any single name would misdescribe it and a composed one would be authored
      microcopy with no live counterpart in either language. A <section> without
      a name is not a landmark, which is the correct outcome. */}
  {
    home.lists && home.lists.length > 0 && (
      <Section bg="paper">
        <div class="lists">
          {home.lists.map((list) => (
            <RuledList list={list} class="reveal" />
          ))}
        </div>
      </Section>
    )
  }

  {/* THE one tint block on this page — `Our philosophy`, where the French page
      has it too (D-71). */}
  {
    home.essay && (
      <Section bg="greige" aria-labelledby="essay-heading">
        <div class="essay">
          {/* <h3>, matching the French page: `Notre philosophie` sits at the
              same level as `Notre mission`, `Nos engagements` and `Ce qui nous
              distingue` in the captured French outline, and the translated
              English blocks keep that outline rather than inventing one. */}
          <h3 id="essay-heading" class="essay__eyebrow">{home.essay.heading}</h3>
          <Prose text={home.essay.body} locale={locale} class="essay__body" />
        </div>
      </Section>
    )
  }

  {/* NC-23. NO PHOTOGRAPH on this one — the French block is a split with a
      photograph whose description exists only in French, and translating an
      image description is authoring one (D-72, P-9). So this is the ruled list
      on its own measure, not a 7/5 split with an empty column. */}
  {
    home.distinctions && (
      <Section bg="paper" aria-labelledby="distinctions-heading">
        <div class="distinctions">
          <RuledList list={home.distinctions} headingId="distinctions-heading" class="reveal" />
        </div>
      </Section>
    )
  }

  <Section bg="paper" aria-labelledby="process-heading">
    <ProcessBlock process={home.process} headingId="process-heading" />

    {/* D-52 — see the note in the frontmatter. Secondary, not primary: the
        page's primary control is its closing contact block. */}
    <div class="onward">
      {
        onward.map((link) => (
          <Button href={link.href} variant="secondary" icon="arrow-right">
            {link.label}
          </Button>
        ))
      }
    </div>
  </Section>

  <Section bg="paper" aria-labelledby="news-heading">
    <NewsBlock news={home.news} headingId="news-heading" />
  </Section>

  <Section bg="paper" aria-labelledby="contact-heading">
    <ContactBlock contact={home.contact} headingId="contact-heading" />
  </Section>
</BaseLayout>

<style>
  /* `Personalized support` — the page's widest breath. Heading left, prose
     right, both at a larger scale than the French equivalent gets, because this
     page carries fewer sections and can afford the room. */
  .support {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  /* D-52 — the two onward links. Wraps to one per row at 375px; every child is
     a <Button>, so the 44px floor is already carried. */
  .onward {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem 1rem;
    margin-block-start: clamp(2rem, 4vw, 2.75rem);
  }

  /* NC-20 / NC-21 — mission and commitments side by side, identical to the
     French page's rule, because they are the same two lists. */
  .lists {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  /* NC-23 — the differentiators, on their own measure rather than in a split.
     The French block pairs this list with a photograph; the English one has no
     description for that photograph (D-72), so the list holds the column alone
     and is capped so the three long items do not run the full 76rem container. */
  .distinctions {
    max-inline-size: 46rem;
  }

  @media (min-width: 48rem) {
    .lists {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(2.5rem, 5vw, 4.5rem);
      align-items: start;
    }
  }

  /* NC-22 — the philosophy essay, set exactly as the French page sets it: a
     quiet label over a large-set paragraph. This is a stated investment
     philosophy (C-27, P-2), not a pull-quote, and setting it as one would dress
     a compliance-sensitive statement up as a slogan. */
  .essay {
    max-inline-size: 54rem;
  }

  .essay__eyebrow {
    margin: 0 0 clamp(1rem, 2vw, 1.5rem);
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: 0.085em;
    text-transform: uppercase;
    color: var(--stone);
  }

  .essay__body {
    margin: 0;
    /* The cap is on the paragraph, not the band: the eyebrow keeps the full
       width. `--measure`, not a hand-picked `ch` count — see global.css. */
    max-inline-size: var(--measure);
    font-size: clamp(1.1875rem, 1.9vw, 1.5rem);
    line-height: 1.5;
    letter-spacing: -0.004em;
  }

  .essay__body :global(strong) {
    font-weight: 600;
  }

  @media (min-width: 60rem) {
    .support {
      grid-template-columns: 5fr 7fr;
      align-items: start;
      column-gap: clamp(3rem, 6vw, 6rem);
    }
  }

  .support__heading {
    margin: 0;
    max-inline-size: 14ch;
  }

  .support__prose {
    margin: 0 0 1.25rem;
    max-inline-size: var(--measure);
    font-size: var(--text-lead);
    line-height: 1.55;
  }

  .support__prose:last-child {
    margin-block-end: 0;
  }

  .company__heading {
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    max-inline-size: 18ch;
  }

  .company {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 60rem) {
    .company {
      grid-template-columns: 6fr 6fr;
      align-items: center;
      column-gap: clamp(2.5rem, 5vw, 4.5rem);
    }
  }

  .company__media {
    aspect-ratio: 767 / 431;
  }

  .company__subheading {
    margin: 0 0 0.25rem;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: 0.085em;
    text-transform: uppercase;
    color: var(--stone);
  }

  .company__points {
    margin: 0;
  }

  .company__point {
    padding-block: clamp(1.25rem, 2.4vw, 1.75rem);
    border-block-end: 1px solid var(--hairline);
  }

  .company__point:first-child {
    border-block-start: 1px solid var(--hairline);
  }

  .company__point-title {
    margin: 0 0 0.5rem;
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.005em;
  }

  .company__point-body {
    margin: 0;
  }

  .company__point-body :global(p) {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
    max-inline-size: 48ch;
  }
</style>
