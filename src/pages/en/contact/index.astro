---
/**
 * ENGLISH CONTACT — `/en/contact/`
 *
 * Route is a deliberate change from the live `contact-us.html`, registered as
 * U-01. The French twin is `/contact/`; the pair is a real one, so the hreflang
 * set comes from `pageKey="contact"`.
 *
 * SECTION ORDER IS THE CAPTURE'S DOCUMENT ORDER:
 *   hero · `We are here to help` + coordinates · `Our team of experts` + the
 *   two advisors.
 *
 * THIS IS THE ONE PAGE PAIR THAT IS A GENUINE TRANSLATION. Everywhere else on
 * this site the English tree is materially thinner and P-16 forbids filling the
 * gap; here both pages carry the same three sections and the same two advisors.
 * So this file is a structural mirror of its French twin — which it is NOT
 * allowed to be anywhere else — and every difference between them is at
 * character level, in the data modules and in `src/data/en.ts`.
 *
 * BAND RHYTHM: paper, ONE greige tint block (the coordinates — the block the
 * live page itself tints), paper again, ink in the footer only.
 *
 * NO `<LegalNotes>`: `en-contact-us.html` renders ZERO `<sup>` and ZERO `<sub>`
 * elements across the whole capture (COMPLIANCE §3.3). NO CONTACT FORM (P-10) —
 * see the note on the French twin.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import ContactHero from '../../_contact/ContactHero.astro';
import OfficeBlock from '../../_contact/OfficeBlock.astro';
import AdvisorCard from '../../_contact/AdvisorCard.astro';
import { t, advisorPath } from '../../../lib/i18n';
import page from '../../../data/pages/contact.en';

const locale = 'en' as const;
const s = t(locale);

/**
 * Pair each advisor with the phone and email rows the SHARED dictionary already
 * holds, by live display name. Nothing is retyped, and a name that stops
 * matching fails the build here instead of shipping a card with a missing line
 * beside a licensed advisor's photograph.
 */
const advisors = page.team.advisors.map((advisor) => {
  const index = s.contact.phones.findIndex((phone) => phone.label === advisor.name);
  const phone = s.contact.phones[index];
  const email = s.contact.emails[index];

  if (!phone || !email) {
    throw new Error(
      `contact.en: no contact row in src/data/en.ts for "${advisor.name}". ` +
        `Advisor names on the contact page must match contact.phones[].label exactly.`,
    );
  }

  return { advisor, phone, email, href: advisorPath(advisor.slug, locale) };
});
---

{/*
   ---------------------------------------------------------------------
   D-11 — the footer's CTA band does not render on the contact page.

   Identical reasoning to the French twin, with this page's own strings: the
   band's eyebrow is `We are here to help`, which is this page's own <h2>
   verbatim, and its button is `Contact us` pointing at `/en/contact/` — the
   page the visitor is already on. No information is lost; both numbers
   appear in the coordinates block, on the advisor cards and in the sticky
   strip.

   This replaces the `body.page-contact .site-footer .cta { display: none }`
   hook this page used while `src/components/` was out of scope for a page
   build. Reverting D-11 is deleting this line.
   ------------------------------------------------------------------
*/}
<BaseLayout
  locale={locale}
  pageKey="contact"
  title={page.meta.title}
  description={page.meta.description}
  showFooterCta={false}
>
  <ContactHero hero={page.hero} />

  {/* THE one tint block on this page — and the one the live page tints too. */}
  <Section bg="greige" aria-labelledby="office-heading">
    <OfficeBlock
      locale={locale}
      heading={page.office.heading}
      lead={page.office.lead}
      headingId="office-heading"
    />
  </Section>

  <Section bg="paper" aria-labelledby="team-heading">
    <h2 id="team-heading" class="t-h2 serif-display team__heading">{page.team.heading}</h2>
    <div class="team__grid">
      {
        advisors.map(({ advisor, phone, email, href }) => (
          <AdvisorCard advisor={advisor} phone={phone} email={email} href={href} />
        ))
      }
    </div>
  </Section>
</BaseLayout>

<style>
  .team__heading {
    margin: 0 0 clamp(1.75rem, 3.5vw, 2.5rem);
    max-inline-size: 18ch;
  }

  .team__grid {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  @media (min-width: 52rem) {
    .team__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
