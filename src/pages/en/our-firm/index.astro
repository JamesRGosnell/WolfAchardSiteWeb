---
/**
 * ENGLISH firm page — `/en/our-firm/`
 *
 * Section order is the CAPTURE's document order, with ONE addition at the top:
 *   hero · ⚠ Wolf Archard Group (NC-28) · A financial partner for Canadian
 *   families · A strong partner · Keep up with financial news · About National
 *   Bank of Canada · Contact us
 *
 * ⚠ D-15 IS ANSWERED, 2026-08-03. The live page carries not one sentence about
 * this team. `firm.team` is now one short paragraph about it, rendering FIRST,
 * above every National Bank block. It is assembled from ENGLISH strings the
 * team already publishes — see the traced note in `firm.en.ts` — and it is NOT
 * a translation of the French paragraph on `/notre-firme/`. It is three
 * sentences where the French is four, deliberately (D-73): the French ends on
 * the four-step process and the English tree has no four-step process.
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * SIX SECTIONS HERE AGAINST SEVEN IN FRENCH, AND THE PAGE IS NOT MISSING ONE.
 *
 * The French page carries a `Petits détails pour tout savoir` accordion holding
 * an Investor Economics ranking claim. **This page has neither the accordion
 * nor the claim** — that is how the live site is, and writing an English
 * version would be translating a competitive ranking claim into a language its
 * compliance file never approved (P-16, C-35). `firm.en.ts` simply has no
 * `note`, so nothing renders and no empty container appears (DESIGN_BRIEF §6).
 *
 * Otherwise the two pages carry the same blocks with materially different
 * strings — `over 850` against `près de 850`, `29%` against `29 %`, a different
 * second intro sentence, and the links falling on different words. None of them
 * are reconciled.
 *
 * NO DISCLAIMER ACCORDION. The capture renders ZERO `<sup>` and ZERO `<sub>`
 * markers — verified directly on `en-our-firm.html` — so the five numbered
 * disclaimers do not belong on this page and P-12 is satisfied by their
 * absence. `LegalNotes.astro` is deliberately not imported.
 *
 * BAND RHYTHM (DESIGN_BRIEF §4): paper everywhere, exactly ONE greige tint
 * block — the `A strong partner` stat band. Ink stays in the footer.
 *
 * Do NOT edit shared files (components, layouts, lib, styles, config,
 * data/{fr,en}.ts) from a page build. Report the friction instead.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import FirmHero from '../../_firme/FirmHero.astro';
import StatBand from '../../_firme/StatBand.astro';
import SplitBlock from '../../_firme/SplitBlock.astro';
import ContactBlock from '../../../components/ContactBlock.astro';
import Prose from '../../../components/Prose.astro';
import firm from '../../../data/pages/firm.en';

const locale = 'en' as const;
---

{/*
   D-11 — this page closes with its own <ContactBlock>, whose button label
   `See Our Contact Details` (C-24 / N-06) exists only here.
*/}
<BaseLayout
  locale={locale}
  pageKey="firm"
  title={firm.meta.title}
  description={firm.meta.description}
  showFooterCta={false}
>
  <FirmHero hero={firm.hero} />

  {/* NC-28 — the team's own paragraph, ABOVE the National Bank material. */}
  {
    firm.team && (
      <Section bg="paper" aria-labelledby="team-heading">
        <div class="team-intro">
          <h2 id="team-heading" class="t-h2 serif-display team-intro__heading">
            {firm.team.heading}
          </h2>
          <Prose text={firm.team.body} locale={locale} class="team-intro__prose" />
        </div>
      </Section>
    )
  }

  <Section bg="paper" aria-labelledby="intro-heading">
    <div class="intro">
      <h2 id="intro-heading" class="t-h2 serif-display intro__heading">{firm.intro.heading}</h2>
      <div class="intro__body">
        {
          firm.intro.body.map((paragraph) => (
            <Prose text={paragraph} locale={locale} class="intro__prose" />
          ))
        }
      </div>
    </div>
  </Section>

  {/* THE one tint block on this page. */}
  <Section bg="greige" aria-labelledby="stats-heading">
    <StatBand band={firm.stats} locale={locale} headingId="stats-heading" />
  </Section>

  <Section bg="paper" aria-labelledby="publications-heading">
    <SplitBlock block={firm.publications} locale={locale} headingId="publications-heading" />
  </Section>

  <Section bg="paper" aria-labelledby="parent-bank-heading">
    <SplitBlock block={firm.parentBank} locale={locale} headingId="parent-bank-heading" />
  </Section>

  {/* NO ranking-note section here. See the header comment — its absence is the
      live site's, and P-16 forbids closing it. */}

  <Section bg="paper" aria-labelledby="contact-heading">
    <ContactBlock contact={firm.contact} headingId="contact-heading" />
  </Section>
</BaseLayout>

<style>
  /* NC-28 — the team's paragraph. Same 5/7 rhythm as the National Bank intro
     below it, so the page reads as one page rather than as an insert bolted on
     top of a bank template. Set at lead size, one step above the block below,
     because it is the only thing on this page that is about the team. */
  .team-intro {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  @media (min-width: 60rem) {
    .team-intro {
      grid-template-columns: 5fr 7fr;
      align-items: start;
      column-gap: clamp(2.5rem, 5vw, 4.5rem);
    }
  }

  .team-intro__heading {
    margin: 0;
    max-inline-size: 14ch;
  }

  .team-intro :global(.team-intro__prose) {
    margin: 0;
    /* --measure, not a hand-picked `ch` count. See the token in global.css. */
    max-inline-size: var(--measure);
    font-size: var(--text-lead);
    line-height: 1.55;
  }

  .intro {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  @media (min-width: 60rem) {
    .intro {
      grid-template-columns: 5fr 7fr;
      align-items: start;
      column-gap: clamp(2.5rem, 5vw, 4.5rem);
    }
  }

  .intro__heading {
    margin: 0;
    max-inline-size: 20ch;
  }

  /* `<Prose>` and `<Figure>` forward the calling component's scope attribute
     (they spread `...rest` onto their root element), so a plain scoped rule
     DOES reach the paragraph they render. This was written as an anchored
     `:global()` descendant before that was true; it is kept because it is
     equally correct and strictly narrower — but a new rule does not need it.
     What is NOT safe is a bare `:global(.foo)` with no scoped ancestor: that
     leaks out of the component. */
  .intro__body :global(.intro__prose) {
    margin: 0 0 1.125rem;
    /* --measure, not a hand-picked `ch` count. See the token in global.css. */
    max-inline-size: var(--measure);
    line-height: 1.65;
  }

  .intro__body :global(.intro__prose:last-child) {
    margin-block-end: 0;
  }
</style>
