---
/**
 * FRENCH team page — `/equipe/`
 *
 * Section order is the CAPTURE's document order:
 * hero · intro · advisors · partners · legal notes.
 *
 * The live page ends with a `Contactez-nous` block — the heading, the sentence
 * `Obtenez les coordonnées des membres de notre équipe…`, a `Voir nos
 * coordonnées` button and the two direct numbers. It is NOT repeated here: D-07
 * moved that exact block into the site footer, where it now renders at the foot
 * of every page. Rendering it again would print the client's own words twice on
 * one page.
 *
 * BAND RHYTHM: paper everywhere, exactly ONE greige tint block (the partners —
 * the page's secondary group, and the only place a tint earns its keep by
 * separating two card sets), ink confined to the footer.
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * THE ORPHAN MARKERS — resolved here, deliberately
 *
 * The live page renders <sup>2</sup> and <sup>1</sup> on the two partners'
 * titles with NO accordion anywhere on the page, in BOTH languages. P-12: a
 * marker resolves on its own page or it does not ship. This rebuild renders the
 * full five-disclaimer <LegalNotes> set below, so both markers resolve to text
 * on this page. Full reasoning at the head of `src/data/pages/team.fr.ts`;
 * registered as D-14.
 *
 * <LegalNotes> always renders all five in order — `refs` marks which ones this
 * page points at and is never a filter (P-13). Disclaimers 3, 4 and 5 therefore
 * render uncited, which is the correct state.
 *
 * Do NOT edit shared files (components, layouts, lib, styles, config,
 * data/{fr,en,types}.ts) from a page build. Report the friction instead.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import TeamCard from '../../components/TeamCard.astro';
import LegalNotes from '../../components/LegalNotes.astro';
import TeamHero from '../_equipe/TeamHero.astro';
import PartnerCard from '../_equipe/PartnerCard.astro';
import team from '../../data/pages/team.fr';
import { advisorsByLocale } from '../../data/advisors';
import { advisorPath } from '../../lib/i18n';

const locale = 'fr' as const;
const advisors = advisorsByLocale[locale];

/* Advisor headshots are 350px wide in the DAM, so the srcset stops there and
   sharp is never asked to generate an upscale. The card column is capped to
   match — see the note in the stylesheet below. */
const ADVISOR_WIDTHS = [280, 350];
const ADVISOR_SIZES = '(min-width: 62rem) 22rem, (min-width: 40rem) 45vw, calc(100vw - 2.5rem)';
---

<BaseLayout
  locale={locale}
  pageKey="team"
  title={team.meta.title}
  description={team.meta.description}
>
  <TeamHero hero={team.hero} />

  <Section bg="paper" aria-labelledby="intro-heading">
    <div class="intro">
      <h2 id="intro-heading" class="t-h2 serif-display intro__heading">
        {team.intro.heading}
      </h2>
      <div class="intro__body">
        {team.intro.body.map((paragraph) => <p class="intro__prose">{paragraph}</p>)}
      </div>
    </div>
  </Section>

  {/* The two registered advisors. Each NAME links to that advisor's own profile
      page, exactly as the live `notre-equipe.html` links it — an unlinked
      profile page is an orphan, and the four routes are not ours to delete.
      ⚠ D-101: the link is the name and nothing else. <TeamCard> used to lay an
      invisible overlay across the whole card, so any click on it navigated to a
      page that repeats this card (D-91). The overlay was ours; the live page
      never had one. Removed there, not here — this call site is unchanged. */}
  <Section bg="paper" aria-labelledby="advisors-heading">
    <h2 id="advisors-heading" class="t-h2 serif-display band__heading">
      {team.advisorsHeading}
    </h2>
    <div class="cards">
      {
        advisors.map((advisor) => (
          <TeamCard
            locale={locale}
            name={advisor.name}
            title={advisor.title.team}
            image={advisor.image}
            imageAlt={advisor.imageAlt}
            widths={ADVISOR_WIDTHS}
            sizes={ADVISOR_SIZES}
            phone={{ display: advisor.phone.display.team, href: advisor.phone.href }}
            email={advisor.email}
            languages={advisor.languages.team}
            href={advisorPath(advisor.slug, locale)}
            level={3}
            class="reveal"
          />
        ))
      }
    </div>
  </Section>

  {/* THE one tint block on this page. */}
  <Section bg="greige" aria-labelledby="partners-heading">
    <h2 id="partners-heading" class="t-h2 serif-display band__heading">
      {team.partners.heading}
    </h2>
    <div class="cards">
      {
        team.partners.people.map((partner) => (
          <PartnerCard locale={locale} partner={partner} class="reveal" />
        ))
      }
    </div>
  </Section>

  {/* Renders the complete 1–5 set. Without it, the two <sup> markers above are
      orphans and the page repeats the live site's P-12 defect. */}
  <Section bg="paper" padding="compact">
    <LegalNotes locale={locale} refs={team.legalRefs} />
  </Section>
</BaseLayout>

<style>
  /* Asymmetric split — heading 5, prose 7. The heading is a full sentence, so it
     gets its own column rather than sitting on top of the paragraphs. */
  .intro {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2rem);
  }

  @media (min-width: 60rem) {
    .intro {
      grid-template-columns: 5fr 7fr;
      align-items: start;
      column-gap: clamp(2.5rem, 5vw, 4.5rem);
    }
  }

  .intro__heading {
    margin: 0;
    max-inline-size: 18ch;
  }

  .intro__prose {
    margin: 0 0 1rem;
    /* --measure, not a hand-picked `ch` count. See the token in global.css. */
    max-inline-size: var(--measure);
    line-height: 1.65;
  }

  .intro__prose:last-child {
    margin-block-end: 0;
  }

  .band__heading {
    margin: 0 0 clamp(2rem, 4vw, 2.75rem);
    max-inline-size: 22ch;
  }

  /* Two large cards. Below 40rem they stack; the portrait is 4:5 in <TeamCard>
     so a single column never leaves a person floating in a wide plate. */
  .cards {
    display: grid;
    gap: clamp(2.5rem, 5vw, 3.5rem);
  }

  @media (min-width: 40rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
      column-gap: clamp(2rem, 4.5vw, 4rem);
    }
  }

  /* The DAM headshots are only 350x330. Capping the column at 22rem (352px)
     keeps the card within a rounding error of the source width instead of
     stretching it across half a 76rem container. The 4:5 portrait crop still
     scales a 330px-tall master vertically — that is an artwork limitation, not
     a build one, and it is why "team photography commissioned" is on the
     pre-launch checklist. The `widths` arrays stop at 350 so sharp is never
     asked to generate an upscale. */
  @media (min-width: 62rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 22rem));
    }
  }
</style>
