---
/**
 * Service row — a hairline-ruled directory line: title, one-liner, arrow.
 * Hover lifts the row onto paper-raised. Stack them inside a `.rule-y` list.
 *
 * THERE IS DELIBERATELY NO INDEX NUMERAL. Decorative `01`–`07` numerals were
 * retired from this system for two reasons: they are one premium device too
 * many, and on a services page they sit inches from the numbered legal-note
 * markers, where a reader cannot tell `01` (decoration) from `1` (a regulatory
 * reference). Removing them closes that confusion by construction. If a page
 * genuinely needs enumeration, use an <ol> and let the list carry it.
 */
import Icon from './Icon.astro';

interface Props {
  title: string;
  summary?: string;
  href?: string;
  /** Heading level of the title inside the surrounding section. */
  level?: 2 | 3 | 4;
  external?: boolean;
  externalLabel?: string;
  id?: string;
  class?: string;
}

const {
  title,
  summary,
  href,
  level = 3,
  external = false,
  externalLabel,
  id,
  class: className,
} = Astro.props;

const Heading = `h${level}` as 'h2' | 'h3' | 'h4';
const Tag = href ? 'a' : 'div';
---

<Tag
  id={id}
  class:list={['srow', href && 'srow--link', className]}
  {...href ? { href } : {}}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  <span class="srow__text">
    <Heading class="srow__title t-h3">{title}</Heading>
    {summary && <span class="srow__summary">{summary}</span>}
  </span>

  {
    href && (
      <span class="srow__arrow" aria-hidden="true">
        <Icon name={external ? 'external-link' : 'arrow-right'} size={18} />
      </span>
    )
  }
  {external && externalLabel && <span class="sr-only">({externalLabel})</span>}
</Tag>

<style>
  .srow {
    display: grid;
    grid-template-columns: 1fr;
    align-items: baseline;
    gap: 0.75rem clamp(1rem, 3vw, 2.25rem);
    min-block-size: 44px;
    padding: clamp(1.25rem, 2.5vw, 1.75rem) clamp(0.75rem, 2vw, 1.25rem);
    margin-inline: clamp(-1.25rem, -2vw, -0.75rem);
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-card);
    transition: background-color 220ms var(--ease-wa);
  }

  .srow--link:hover {
    background-color: var(--surface-raised);
  }

  .srow__text {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .srow__title {
    margin: 0;
  }

  .srow__summary {
    font-size: var(--text-small);
    line-height: 1.55;
    color: var(--muted);
    max-inline-size: 58ch;
  }

  .srow__arrow {
    display: inline-flex;
    align-items: center;
    color: var(--muted);
    transition:
      transform 220ms var(--ease-wa),
      color 220ms var(--ease-wa);
  }

  .srow--link:hover .srow__arrow {
    color: var(--fg);
    transform: translateX(3px);
  }

  @media (min-width: 48rem) {
    .srow {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
</style>
