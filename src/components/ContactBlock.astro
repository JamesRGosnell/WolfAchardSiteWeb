---
/**
 * A page's own closing contact block — LIVE CONTENT, not chrome.
 *
 * SHARED. `_home/ContactBlock.astro` and `_firme/ContactBlock.astro` were
 * byte-similar copies, and three page trees (home, services, firm) already
 * imported one or the other across tree boundaries. One file now.
 *
 * ⚠ ANY PAGE THAT RENDERS THIS MUST PASS `showFooterCta={false}`.
 * `<Footer>`'s CTA band (D-07) carries the same heading, the same lead sentence
 * and the same two direct numbers. Rendering both prints `Contactez-nous` twice
 * on one page, 800px apart. The suppression is per page and deliberate — see
 * D-11 and the page-by-page table in CHANGES-FOR-APPROVAL.md.
 *
 * WHY PAGES RENDER IT AT ALL, given the footer band exists: the button LABEL is
 * per-page live copy and differs between pages. The English firm page says
 * `See Our Contact Details`, title-cased, against `See our contact details` on
 * the other four English pages (C-24 / N-06); the English services page's lead
 * is `Our team members are there for you. Contact us directly at`, a sentence
 * that exists nowhere else on the site. Dropping these blocks in favour of the
 * one footer band would delete the only instance of each from the build.
 *
 * On the live page this is an <h3>, not an <h2>, on every page that has one.
 * That is reproduced: the heading level is part of the captured document
 * outline.
 *
 * THE RED PICTOGRAMS ARE NOT REPRODUCED. The live block sets the phone and mail
 * marks as 80×80 red PNGs (`picto-telephone-rouge`, `picto-courriel-rouge`).
 * Brand red on this site is disciplined to disclaimer superscripts and focus
 * rings — an icon in red spends the whole budget on decoration — so the two
 * marks are drawn from the site's own icon set in `--stone` instead. No wording
 * changes: the pictograms were decorative platform artwork whose alt text
 * (`Picto téléphone` / `Phone picto`) asserted nothing.
 *
 * Numbers and addresses are per-language verbatim and are NOT derived from one
 * another: French spaces the phone numbers and uses `@bnc.ca`, English
 * hyphenates them and uses `@nbc.ca` (C-03…C-06, P-4).
 */
import Button from './Button.astro';
import Icon from './Icon.astro';
import type { SiteContactBlock } from '../data/types';

interface Props {
  contact: SiteContactBlock;
  headingId: string;
}

const { contact, headingId } = Astro.props;
---

<div class="contact">
  <div class="contact__intro">
    <h3 id={headingId} class="t-h2 serif-display contact__title">{contact.heading}</h3>
    <p class="t-lead measure contact__lead">{contact.lead}</p>
    <div class="contact__action">
      <Button href={contact.link.href} icon="arrow-right">{contact.link.label}</Button>
    </div>
  </div>

  <ul class="contact__lines">
    {
      contact.phones.map((phone) => (
        <li class="contact__line">
          <Icon name="phone" size={18} class="contact__icon" />
          <a class="contact__value tabular" href={phone.href}>
            {phone.display}
          </a>
        </li>
      ))
    }
    {
      contact.emails.map((email) => (
        <li class="contact__line">
          <Icon name="mail" size={18} class="contact__icon" />
          <a class="contact__value" href={email.href}>
            {email.display}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .contact {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  @media (min-width: 60rem) {
    .contact {
      grid-template-columns: 7fr 5fr;
      align-items: start;
      column-gap: clamp(2.5rem, 5vw, 5rem);
    }
  }

  .contact__title {
    margin: 0;
  }

  .contact__lead {
    margin-block: 1rem 0;
  }

  .contact__action {
    margin-block-start: clamp(1.5rem, 3vw, 2rem);
  }

  .contact__lines {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The row's own padding and the link's tap-target floor together make 56px,
     and they trade against each other: the padding came down from 0.875rem to
     0.375rem at the same moment `.contact__value` went from 28px to 44px, so
     the hairlines and the text sit exactly where they did before. Change one
     of the two numbers and the footer rhythm moves. */
  .contact__line {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding-block: 0.375rem;
    border-block-end: 1px solid var(--hairline);
  }

  .contact__line:first-child {
    border-block-start: 1px solid var(--hairline);
  }

  /* Icons rest in --stone. Never red. `<Icon>` spreads the scope attribute this
     component passes it, so this plain class selector does reach the <svg>. */
  .contact__icon {
    flex: none;
    color: var(--stone);
  }

  /* 44px, not 28px, and the type does NOT grow to get there.
     These `tel:` and `mailto:` links are the site's primary conversion path —
     there is no contact form anywhere — so they are the last targets that may
     sit under the WCAG 2.5.5 floor. The box is padded out around a 17px label
     that keeps its size; `min-inline-size` is a formality here (the shortest
     value, a 12-character phone number, already measures ~110px) but it is
     declared so a future shorter label cannot silently fall through 44px. */
  .contact__value {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    min-inline-size: 44px;
    font-size: 1.0625rem;
    font-weight: 500;
    text-decoration: none;
    /* Long addresses must never push the grid wider than its column. */
    overflow-wrap: anywhere;
  }

  .contact__value:hover {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }
</style>
